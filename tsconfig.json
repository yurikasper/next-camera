{
    "compilerOptions": {
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false
    },
    "include": ["src", "test", "scripts"],
    "exclude": ["test/fixtures"]
}
